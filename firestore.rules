rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Health check ping collection
    match /test/connection {
      allow read: if true;
    }

    // User private data store for cross-device sync
    match /users/{userId}/data/{docId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
      allow list: if isOwner(userId) && isValidId(userId);
      allow create, update: if isOwner(userId)
        && isValidId(userId)
        && isValidId(docId)
        && request.resource.data.ownerId == request.auth.uid;
      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
    }
  }
}
